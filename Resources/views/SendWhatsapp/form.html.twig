<div class="modal-body">
    <div class="alert alert-info">
        {{ 'whatsaas.send.description'|trans({'%contact%': contact.getName()}) }}
    </div>

    <div class="alert alert-warning">
        <strong>Let op!</strong> Gebruiker moet goedkeuring vooraf hebben gegeven!
    </div>

    {{ form_start(form) }}

    {% if form.channel is defined %}
        {{ form_row(form.channel) }}
    {% endif %}

    {% if form.smsTemplate is defined %}
        {{ form_row(form.smsTemplate) }}
        <div class="text-center text-muted mb-2" style="margin: -5px 0 10px; font-size: 12px;">
            &mdash; {{ 'whatsaas.send.or_custom_message'|trans }} &mdash;
        </div>
    {% endif %}

    {{ form_row(form.messageType) }}
    {{ form_row(form.message) }}

    <div id="whatsaas-media-fields" style="display:none;">
        {{ form_row(form.mediaUrl) }}
    </div>

    {{ form_row(form.contactId) }}
    {{ form_row(form.buttons) }}
    {{ form_end(form) }}
</div>

<script>
var WhatSaaS = {
    templates: {{ templateMessages|json_encode|raw }},
    toggleFields: function(type) {
        var mediaFields = document.getElementById('whatsaas-media-fields');
        mediaFields.style.display = (type !== 'text') ? 'block' : 'none';
    },
    loadTemplate: function(select) {
        var templateId = select.value;
        if (templateId && WhatSaaS.templates[templateId]) {
            document.getElementById('whatsaas_send_message').value = WhatSaaS.templates[templateId];
        }
    }
};
</script>
